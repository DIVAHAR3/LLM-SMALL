# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed; this file (.env.example) IS committed and must
# never contain real secrets, only placeholders.

# Shared-secret key required in the X-API-Key header for POST /generate
# (see Phase 19 / docs/SECURITY.md). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=changeme-generate-a-real-random-key

# Comma-separated list of origins allowed to call this API from a browser.
# Empty/unset = no browser origins allowed (server-to-server / curl still
# works regardless -- CORS only affects browser-enforced requests).
ALLOWED_ORIGINS=
