# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

# Base URL of the local FastAPI server (see ../api/main.py)
VITE_API_URL=http://127.0.0.1:8000

# Must match the backend's API_KEY (see ../.env / ../docs/SECURITY.md).
# WARNING: this gets bundled into client-side JS -- anyone loading the page
# can read it. Acceptable only because this project is local-only and
# single-user right now; see the note in src/api.js.
VITE_API_KEY=changeme-must-match-backend-API_KEY
