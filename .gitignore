# Virtual environment
.venv/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Secrets
.env

# Checkpoints and logs (never commit large binaries)
checkpoints/
logs/

# Processed data and derived tokenizer vocab are regenerable from data/raw/
# via scripts/prepare_data.py — not versioned, including per-experiment
# variants (e.g. data/processed_exp1/, tokenizer/vocab_exp1.json). data/raw/
# itself IS committed as long as it stays small and legal/original (see
# CLAUDE.md hard rule 5).
data/processed*/
tokenizer/vocab*.json

# Frontend
frontend/node_modules/
frontend/dist/

# Raw benchmark output is machine/load-dependent and regenerable via
# scripts/benchmark.py -- docs/BENCHMARKS.md holds the durable discussion.
docs/benchmark_results.json

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
